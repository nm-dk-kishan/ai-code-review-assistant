// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  projects      Project[]
  reviews       Review[]
  chatSessions  ChatSession[]
  aiProviders   AIProvider[]
}

model Project {
  id        String     @id @default(cuid())
  userId    String
  name      String
  description String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  files     File[]
  reviews   Review[]

  @@index([userId])
}

model File {
  id        String     @id @default(cuid())
  projectId String
  path      String
  content   String
  language  String?
  size      Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Review {
  id          String     @id @default(cuid())
  userId      String
  projectId   String
  fileIds     String[]   // JSON array of file IDs
  mode        String     // "security", "performance", "quality"
  summary     String?
  issues      Json       // Array of issues
  recommendations String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
}

model AIProvider {
  id        String     @id @default(cuid())
  userId    String
  name      String     // "openai", "lm-studio", "custom"
  baseUrl   String
  apiKey    String     // Encrypted in production
  modelName String
  isDefault Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChatSession {
  id        String     @id @default(cuid())
  userId    String
  projectId String?
  title     String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id        String     @id @default(cuid())
  sessionId String
  role      String     // "user", "assistant"
  content   String
  createdAt DateTime   @default(now())

  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
